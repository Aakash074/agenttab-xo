pragma cashscript ^0.14.0;

// AgentTab: a refundable, unidirectional payment channel ("tab") for an AI agent.
//
//  - The "owner" (a human wallet, or the agent itself) locks a budget in ONE utxo at this contract.
//  - The "agent" key can only sign spending vouchers; it can never withdraw. For every paid API
//    call it signs an off-chain voucher for the CUMULATIVE amount owed:
//        voucher = datasig(agent, "AGENTTAB" ++ outpointTxHash ++ outpointIndex(4) ++ amount(8))
//    The voucher is bound to the exact funding outpoint, so it can never be replayed against
//    another tab (or a second utxo accidentally sent to the same address).
//  - The provider can settle at any time with the highest voucher it holds:
//        output 0 -> provider, at most `amount` (provider pays the miner fee out of its own share)
//        output 1 -> owner, EXACTLY budget - amount (the remainder is forced back)
//  - The provider can instead `cancel`: the whole budget (minus a fee of at most 1000 sats) returns to the owner.
//  - After `timeout` (absolute nLockTime: block height < 500M, or unix time >= 500M) the owner
//    can reclaim everything. The provider must settle before the timeout.
contract AgentTab(pubkey owner, pubkey agent, pubkey provider, int timeout) {
    function settle(sig providerSig, datasig voucher, bytes8 amountBytes) {
        // Exactly one input (the tab utxo) and exactly two outputs: no bundling of several
        // tab utxos into one tx, no extra outputs siphoning value.
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 2);

        require(checkSig(providerSig, provider));

        // Voucher must be signed by the agent over this exact funding outpoint and amount.
        bytes outpoint = tx.inputs[0].outpointTransactionHash + toPaddedBytes(tx.inputs[0].outpointIndex, 4);
        require(checkDataSig(voucher, 0x4147454e54544142 + outpoint + amountBytes, agent));

        int amount = int(amountBytes);
        int budget = tx.inputs[0].value;
        int remainder = budget - amount;
        require(amount >= 546);
        require(remainder >= 546);

        // Provider gets at most the signed amount (and pays the fee from it).
        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(hash160(provider)));
        require(tx.outputs[0].value <= amount);
        require(tx.outputs[0].tokenCategory == 0x);

        // Owner gets exactly the remainder.
        require(tx.outputs[1].lockingBytecode == new LockingBytecodeP2PKH(hash160(owner)));
        require(tx.outputs[1].value == remainder);
        require(tx.outputs[1].tokenCategory == 0x);
    }

    // Provider waives the tab: everything goes back to the owner right away (minus a capped miner fee).
    // Used when there is too little owed to be worth settling, or as a goodwill early close.
    function cancel(sig providerSig) {
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 1);
        require(checkSig(providerSig, provider));
        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(hash160(owner)));
        require(tx.outputs[0].value >= tx.inputs[0].value - 1000);
        require(tx.outputs[0].tokenCategory == 0x);
    }

    function refund(sig ownerSig) {
        require(checkSig(ownerSig, owner));
        require(tx.time >= timeout);
    }
}
